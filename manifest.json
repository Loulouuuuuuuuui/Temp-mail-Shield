{
  "manifest_version": 3,
  "name": "TempMail Shield - E-mail Temporaire & Identifiants",
  "version": "1.0.0",
  "description": "Générez des adresses e-mail temporaires et des mots de passe robustes pour vos inscriptions, avec remplissage automatique et surveillance des codes de confirmation.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.mail.tm/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TempMail Shield",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
